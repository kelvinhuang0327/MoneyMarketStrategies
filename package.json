{
  "name": "money-market-strategies",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @mms/contracts && npm run build --workspace @mms/research-kernel && npm run build --workspace @mms/experiment-registry && npm run build --workspace @mms/research-runner && npm run build --workspace @mms/strategy-simulator && npm run build --workspace @mms/paper-trading",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint packages vitest.config.ts",
    "test": "vitest run",
    "paper:demo": "npm run build --workspace @mms/paper-trading && node packages/paper-trading/dist/demo.js",
    "paper:run": "npm run build --workspace @mms/paper-trading && node packages/paper-trading/dist/sessionRunner.js",
    "paper:baseline": "npm run build --workspace @mms/paper-trading && node packages/paper-trading/dist/historicalBaseline.js",
    "paper:optimize-win-rate": "npm run build --workspace @mms/paper-trading && node packages/paper-trading/dist/winRateOptimizer.js",
    "paper:optimize-win-rate-v2": "npm run build --workspace @mms/paper-trading && node packages/paper-trading/dist/winRateOptimizerV2.js",
    "paper:select-win-rate-strategy-v1": "npm run build --workspace @mms/paper-trading && node packages/paper-trading/dist/winRateStrategySelectorV1.js",
    "paper:validate-cross-symbol-win-rate": "npm run build --workspace @mms/paper-trading && node packages/paper-trading/dist/crossSymbolWinRateValidationV1.js",
    "paper:evaluate-forward-win-rate": "npm run build --workspace @mms/paper-trading && node packages/paper-trading/dist/forwardWinRateEvaluator.js",
    "paper:select-zscore-win-rate": "npm run build --workspace @mms/paper-trading && node packages/paper-trading/dist/zscoreWinRateSelector.js",
    "paper:select-zscore-risk-normalized-win-rate": "npm run build --workspace @mms/paper-trading && node packages/paper-trading/dist/zscoreRiskNormalizedWinRateSelector.js",
    "paper:evaluate-zscore-forward": "npm run build --workspace @mms/paper-trading && node packages/paper-trading/dist/zscoreCrossSymbolForwardEvaluator.js",
    "paper:evaluate-risk-normalized-zscore-forward": "npm run build --workspace @mms/paper-trading && node packages/paper-trading/dist/zscoreRiskNormalizedCrossSymbolForwardEvaluator.js",
    "verify": "npm run lint && npm run build && npm run typecheck && npm test",
    "research:tw": "node scripts/runTwStrategyResearchStudy.mjs",
    "inspect:prediction-result": "node scripts/inspectPredictionRetrainingResult.mjs",
    "inspect:research-run": "node scripts/inspectTwResearchRun.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "eslint": "10.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
